{
  "name": "fe-monorepo-playground",
  "private": true,
  "engines": {
    "node": ">= 22",
    "pnpm": "^10"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "core-js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/njzydark/fe-monorepo-playground.git"
  },
  "author": "njzydark",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/njzydark/fe-monorepo-playground/issues"
  },
  "homepage": "https://github.com/njzydark/fe-monorepo-playground#readme",
  "devDependencies": {
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "postcss": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "stylelint-less": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "build:examples": "pnpm --filter \"./examples/*\" build",
    "format": "oxfmt . && stylelint \"**/*.{css,less}\" --ignore-pattern \"**/dist/**\" --ignore-pattern \"**/types/**\" --ignore-pattern \"**/node_modules/**\" --fix",
    "format:check": "oxfmt . --check && stylelint \"**/*.{css,less}\" --ignore-pattern \"**/dist/**\" --ignore-pattern \"**/types/**\" --ignore-pattern \"**/node_modules/**\"",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "prepare": "husky"
  }
}
