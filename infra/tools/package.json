{
  "name": "infra-tools",
  "version": "0.0.1",
  "description": "infra tools for monorepo packages",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">= 18.12.0"
  },
  "exports": {
    "./rslib": {
      "import": "./src/rslib/index.ts"
    },
    "./rsbuild": {
      "import": "./src/rsbuild/index.ts"
    },
    "./rstest": {
      "import": "./src/rstest/index.ts"
    }
  },
  "scripts": {
    "build": "RSLIB_DTS=true rslib build",
    "build:nonedts": "RSLIB_DTS=false rslib build",
    "dev": "RSLIB_DTS=true rslib build -w",
    "prepublishOnly": "npm run build",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src --deny-warnings",
    "lint:fix": "oxlint src --fix",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-less": "catalog:",
    "@rsbuild/plugin-react": "catalog:",
    "@rsbuild/plugin-source-build": "catalog:",
    "@rsbuild/plugin-svgr": "catalog:",
    "@rslib/core": "catalog:",
    "@rstest/adapter-rsbuild": "catalog:",
    "@rstest/adapter-rslib": "catalog:",
    "@rstest/core": "catalog:",
    "@rstest/coverage-istanbul": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/node": "catalog:",
    "glob": "catalog:",
    "happy-dom": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rsbuild-plugin-devtools-json": "catalog:",
    "typescript": "catalog:"
  }
}
